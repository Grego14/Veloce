---
import '../styles/global.css'
import Logo from '@components/icons/VeloceLogo'
import MenuDrawer from '@components/MenuDrawer.astro'
import CartDrawer from '@components/CartDrawer.astro'

import { appName, getLangFromUrl } from '@i18n/utils'

import { es } from '@i18n/locales/es'
import { en } from '@i18n/locales/en'

interface Props {
  slogan?: string
}

const { slogan } = Astro.props
const lang = getLangFromUrl(Astro.url)
const dict = lang === 'es' ? es : en
const headerSlogan = slogan ?? dict['header.slogan']
const otherLang = lang === 'es' ? 'en' : 'es'
const currentPath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/'
const languageHref =
  otherLang === 'en'
    ? `/en${currentPath === '/' ? '/' : currentPath}`
    : currentPath
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{appName}</title>
  </head>
  <body class='p-4 flex-col items-center'>
    <header class='mb-4 px-4 py-2 sm:px-6 md:px-8'>
      <div class='flex items-center'>
        <a href={lang === 'es' ? '/' : '/en/'} class="flex items-center max-w-fit">
          <Logo class='w-7 h-7 sm:w-10 sm:h-10 md:w-12 md:h-12' />
          <h1 class='ml-2 tracking-[0.12em] uppercase'>{appName}</h1>
        </a>

        <div class='ml-auto flex items-center gap-4'>
          <a
            href={languageHref}
            class='px-2 py-1 text-sm font-semibold uppercase tracking-wider transition-colors hover:bg-zinc-100'
            aria-label={`${dict['nav.language']}: ${otherLang === 'es' ? 'Español' : 'English'}`}
          >
            {otherLang}
          </a>
          <MenuDrawer />
        </div>
      </div>

      <h2 class='mt-4 text-center text-5xl sm:text-left'>{headerSlogan}</h2>
    </header>

    <slot />
    <CartDrawer />

    <script>
      import { setLanguage } from '@stores/i18nStore'

      const currentLang = document.documentElement.lang as 'es' | 'en'
      setLanguage(currentLang || 'es')
    </script>
  </body>
</html>
