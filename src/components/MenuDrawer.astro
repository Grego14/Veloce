---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { categories, getLangFromUrl } from '@i18n/utils'
import { es } from '@i18n/locales/es'
import { en } from '@i18n/locales/en'

const lang = getLangFromUrl(Astro.url)
const dict = lang === 'es' ? es : en
---

<button
  type='button'
  class='flex h-10 w-10 items-center justify-center border-2 border-zinc-950 transition-colors hover:bg-zinc-950 hover:text-white'
  aria-label={dict['nav.menu.open']}
  aria-controls='site-drawer'
  aria-expanded='false'
  data-open-drawer
>
  <svg viewBox='0 0 24 24' class='h-6 w-6' fill='none' stroke='currentColor' stroke-width='2' aria-hidden='true'>
    <path d='M4 6h16M4 12h16M4 18h16' />
  </svg>
</button>

<div class='drawer-overlay fixed inset-0 z-40 hidden bg-zinc-950/50' data-drawer-overlay></div>

<aside
  id='site-drawer'
  class='drawer fixed right-0 top-0 z-50 flex h-full w-[min(24rem,calc(100%-1rem))] flex-col bg-white p-6 transition-transform duration-300 sm:p-8'
  aria-label={dict['nav.catalog']}
  aria-hidden='true'
>
  <div class='flex items-center justify-between'>
    <span class='text-sm font-semibold uppercase tracking-[0.18em]'>{dict['nav.catalog']}</span>
    <button
      type='button'
      class='flex h-10 w-10 items-center justify-center border-2 border-zinc-950 transition-colors hover:bg-zinc-950 hover:text-white'
      aria-label={dict['nav.menu.close']}
      data-close-drawer
    >
      <svg viewBox='0 0 24 24' class='h-6 w-6' fill='none' stroke='currentColor' stroke-width='2' aria-hidden='true'>
        <path d='m6 6 12 12M18 6 6 18' />
      </svg>
    </button>
  </div>

  <p class='mt-10 text-2xl font-light leading-tight'>{dict['nav.catalogDescription']}</p>

  <nav class='mt-10' aria-label={dict['nav.categories']}>
    <h2 class='mb-4 text-sm font-semibold uppercase tracking-[0.18em]'>{dict['nav.categories']}</h2>
    <ul class='space-y-3'>
      {categories.map(category => (
        <li>
          <a
            class='group flex items-center justify-between border-b border-zinc-200 pb-2 text-lg font-medium transition-colors hover:border-zinc-950'
            href={getRelativeLocaleUrl(lang, `catalog/${category}`)}
          >
            {dict[`category.${category}`]}
            <span class='text-xl transition-transform group-hover:translate-x-1' aria-hidden='true'>→</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>

<script>
  class AstroDrawer {
    drawer: HTMLElement
    overlay: HTMLElement
    openBtn: HTMLButtonElement
    closeBtns: NodeListOf<HTMLButtonElement>

    constructor(element: HTMLElement) {
      this.drawer = element
      this.overlay = document.querySelector<HTMLElement>('[data-drawer-overlay]')!
      this.openBtn = document.querySelector<HTMLButtonElement>('[data-open-drawer]')!
      this.closeBtns = element.querySelectorAll<HTMLButtonElement>('[data-close-drawer]')
      this.init()
    }

    init() {
      this.openBtn.addEventListener('click', () => this.open())

      for (const btn of this.closeBtns) {
        btn.addEventListener('click', () => this.close())
      }

      this.overlay.addEventListener('click', () => this.close())
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape') this.close()
      })
    }

    open() {
      this.drawer.setAttribute('aria-hidden', 'false')
      this.openBtn.setAttribute('aria-expanded', 'true')
      this.drawer.classList.add('is-open')
      this.overlay.classList.add('is-open')
      document.body.classList.add('overflow-hidden')
    }

    close() {
      this.drawer.setAttribute('aria-hidden', 'true')
      this.openBtn.setAttribute('aria-expanded', 'false')
      this.drawer.classList.remove('is-open')
      this.overlay.classList.remove('is-open')
      document.body.classList.remove('overflow-hidden')
    }
  }

  const drawerElements = document.querySelectorAll<HTMLElement>('.drawer')
  for (const element of drawerElements) {
    new AstroDrawer(element)
  }
</script>

<style>
  .drawer:not(.is-open) {
    box-shadow: none;
    transform: translateX(100%);
  }

  .drawer.is-open {
    box-shadow: -1rem 0 2rem -1.5rem rgb(0 0 0 / 0.35);
    transform: translateX(0);
  }

  .drawer-overlay.is-open {
    display: block;
  }
</style>
