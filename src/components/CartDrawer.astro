---
import { ShoppingCart, X } from 'lucide-preact'

import { es } from '@i18n/locales/es'
import { en } from '@i18n/locales/en'
import { getLangFromUrl } from '@i18n/utils'

const lang = getLangFromUrl(Astro.url)
const dict = lang === 'es' ? es : en
---

<button
  type='button'
  class='fixed bottom-6 right-6 z-30 flex h-14 w-14 items-center justify-center bg-zinc-950 text-white shadow-lg transition-transform hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:ring-offset-2'
  aria-label={dict['cart.open']}
  aria-controls='cart-drawer'
  aria-expanded='false'
  data-open-cart
>
  <ShoppingCart size={24} strokeWidth={2} aria-hidden='true' />
  <span
    class='absolute -right-1 -top-1 hidden min-w-5 rounded-full bg-rose-600 px-1.5 py-0.5 text-center text-xs font-bold text-white'
    data-cart-count
  >
  </span>
</button>

<div class='fixed inset-0 z-40 hidden bg-zinc-950/50' data-cart-overlay></div>

<aside
  id='cart-drawer'
  class='cart-drawer fixed right-0 top-0 z-50 flex h-full w-[min(24rem,calc(100%-1rem))] flex-col bg-white p-6 transition-transform duration-300 sm:p-8'
  aria-label={dict['cart.title']}
  aria-hidden='true'
>
  <div class='flex items-center justify-between'>
    <h2 class='text-2xl font-medium'>{dict['cart.title']}</h2>
    <button
      type='button'
      class='flex h-10 w-10 items-center justify-center border-2 border-zinc-950 transition-colors hover:bg-zinc-950 hover:text-white'
      aria-label={dict['cart.close']}
      data-close-cart
    >
      <X size={22} strokeWidth={2} aria-hidden='true' />
    </button>
  </div>

  <div class='mt-8 flex-1 overflow-y-auto' data-cart-content>
    <p class='text-lg font-light'>{dict['cart.empty']}</p>
  </div>

  <div class='mt-6 flex items-center justify-between border-t-2 border-zinc-950 pt-4 text-lg font-semibold'>
    <span>{dict['cart.total']}</span>
    <span data-cart-total>$0.00</span>
  </div>
</aside>

<script define:vars={{ translations: {
  empty: dict['cart.empty'],
  remove: dict['cart.remove'],
}, locale: lang }}>
  import { cartItems, isCartOpen, removeFromCart } from '@stores/cartStore'
  const drawer = document.querySelector<HTMLElement>('#cart-drawer')
  const overlay = document.querySelector<HTMLElement>('[data-cart-overlay]')
  const openButton = document.querySelector<HTMLButtonElement>('[data-open-cart]')
  const closeButton = document.querySelector<HTMLButtonElement>('[data-close-cart]')
  const content = document.querySelector<HTMLElement>('[data-cart-content]')
  const total = document.querySelector<HTMLElement>('[data-cart-total]')
  const count = document.querySelector<HTMLElement>('[data-cart-count]')

  if (!drawer || !overlay || !openButton || !closeButton || !content || !total || !count) {
    throw new Error('Cart drawer elements are missing')
  }

  const formatPrice = (price: number) => `$${price.toFixed(2)}`

  const render = () => {
    const items = Object.values(cartItems.get()).filter(item => item !== undefined)
    const itemCount = items.reduce((sum, item) => sum + item.quantity, 0)
    const cartTotal = items.reduce((sum, item) => sum + item.price * item.quantity, 0)

    count.textContent = String(itemCount)
    count.classList.toggle('hidden', itemCount === 0)
    total.textContent = formatPrice(cartTotal)

    if (items.length === 0) {
      content.innerHTML = `<p class="text-lg font-light">${translations.empty}</p>`
      return
    }

    content.innerHTML = items
      .map(
        item => `
          <article class="flex gap-3 border-b border-zinc-200 py-4 first:pt-0">
            <img class="h-20 w-20 object-contain bg-zinc-100" src="${item.image.src}" alt="${item.name[locale]}" />
            <div class="min-w-0 flex-1">
              <div class="flex items-start justify-between gap-2">
                <h3 class="font-medium leading-tight">${item.name[locale]}</h3>
                <button
                  type="button"
                  class="shrink-0 text-zinc-500 transition-colors hover:text-rose-600"
                  aria-label="${translations.remove} ${item.name[locale]}"
                  data-remove-cart-item="${item.id}"
                >
                  <span class="sr-only">${translations.remove}</span>
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M3 6h18M8 6V4h8v2m-9 0 1 14h8l1-14M10 11v5m4-5v5" />
                  </svg>
                </button>
              </div>
              <p class="mt-2 text-sm text-zinc-500">${item.quantity} × ${formatPrice(item.price)}</p>
            </div>
          </article>
        `,
      )
      .join('')
  }

  const setOpen = (open: boolean) => {
    drawer.setAttribute('aria-hidden', String(!open))
    openButton.setAttribute('aria-expanded', String(open))
    drawer.classList.toggle('is-open', open)
    overlay.classList.toggle('hidden', !open)
    document.body.classList.toggle('overflow-hidden', open)
  }

  openButton.addEventListener('click', () => isCartOpen.set(true))
  closeButton.addEventListener('click', () => isCartOpen.set(false))
  overlay.addEventListener('click', () => isCartOpen.set(false))
  content.addEventListener('click', event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-remove-cart-item]')
    if (button) removeFromCart(button.dataset.removeCartItem!)
  })
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') isCartOpen.set(false)
  })

  cartItems.subscribe(render)
  isCartOpen.subscribe(setOpen)
</script>

<style>
  .cart-drawer:not(.is-open) {
    box-shadow: none;
    transform: translateX(100%);
  }

  .cart-drawer.is-open {
    box-shadow: -1rem 0 2rem -1.5rem rgb(0 0 0 / 0.35);
    transform: translateX(0);
  }
</style>
