---
import { Image } from 'astro:assets'
import { getCollection, type CollectionEntry } from 'astro:content'
import { getRelativeLocaleUrl } from 'astro:i18n'

import { es } from '@i18n/locales/es'
import { en } from '@i18n/locales/en'

import AddToCart from './AddToCart'
import Star from '@icons/Star'

type Product = CollectionEntry<'products'>['data'][number]

interface Props {
  lang: 'es' | 'en'
  products?: Product[]
  showAddToCart?: boolean
}

const { lang, products: providedProducts, showAddToCart = true } = Astro.props
const t = lang === 'es' ? es : en
const products =
  providedProducts ?? (await getCollection('products')).flatMap(entry => entry.data)
---

<section
  class='grid grid-cols-2 items-stretch gap-3 sm:gap-4 md:grid-cols-3 xl:grid-cols-4'
  aria-label={t['products']}
>
{products && products.map(product => {
    const url = product.id.split('_')[0]
    const colorCount = product.colors?.length ?? 0
    const colorLabel = colorCount === 1 ? t['product.color'] : t['product.colors']
    const tags = product.tags?.slice(0, 2)
    const ratingStars = Math.floor(product.rating)

    return (
      <article class='group flex min-w-0 flex-col overflow-hidden rounded-lg border border-zinc-200 bg-white transition-colors hover:border-zinc-400'>
        <a
          class='block'
          href={getRelativeLocaleUrl(lang, `catalog/${url}/${product.id}`)}
        >
          <div class='relative aspect-[4/3] overflow-hidden bg-zinc-100'>
            <Image
              src={product.image}
              alt={product.description[lang]}
              class='h-full w-full object-contain object-center transition-transform duration-300 group-hover:scale-105'
              fit='contain'
              position='center'
              loading='lazy'
              decoding='async'
            />
            {!product.inStock ? (
              <span
                class='absolute right-2 top-2 bg-rose-600 px-2 py-1 text-[0.65rem] font-semibold uppercase tracking-wide text-white'
                role='alert'
              >
                {t['product.outOfStock']}
              </span>
            ) : null}
          </div>
          <p class='px-3 pt-3 text-[0.6rem] font-medium uppercase tracking-[0.12em] text-zinc-500 sm:text-[0.65rem]'>
            {product.category}
          </p>
          <h3 class='line-clamp-2 px-3 pt-1 text-base font-medium leading-tight group-hover:underline sm:text-lg'>
            {product.name[lang]}
          </h3>
        </a>

        <div class='flex flex-1 flex-col px-3 pb-3 pt-2'>
          <span class='text-lg font-semibold tracking-tight sm:text-xl'>${product.price.toFixed(2)}</span>

          <div class='mt-2 flex items-center justify-between gap-1 border-t border-zinc-200 pt-2 text-[0.65rem] text-zinc-600'>
            <span
              class='flex items-center gap-1 text-amber-500'
              aria-label={`${t['product.rating']}: ${product.rating.toFixed(1)}`}
            >
              {
                Array.from({ length: 5 }, (_, index) => (
                  <Star
                    className={`h-3.5 w-3.5 ${index < ratingStars ? 'fill-current' : 'text-zinc-300'}`}
                  />
                ))
              }
              <span class='font-medium text-zinc-700'>{product.rating.toFixed(1)}</span>
            </span>
            <span class='truncate text-right'>{colorCount} {colorLabel}</span>
          </div>

          {Array.isArray(tags) ? (
            <div class='mt-2 flex min-h-5 flex-wrap gap-1'>
              {tags.map(tag => (
                <span class='border border-zinc-200 bg-zinc-100 px-1.5 py-0.5 text-[0.6rem] uppercase tracking-wide text-zinc-500'>
                  {tag.replace(/^#/, '')}
                </span>
              ))}
            </div>
          ) : null}

          {showAddToCart ? <AddToCart client:idle lang={lang} product={product} /> : null}
        </div>
      </article>
    )
  })}
</section>
