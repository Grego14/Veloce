---
import Layout from '@layouts/Layout.astro'
import { getRelativeLocaleUrl } from 'astro:i18n'

import { es } from '@i18n/locales/es'
import { en } from '@i18n/locales/en'
import AnnouncementsBar from '@components/AnnouncementsBar.astro'
import Products from '@components/Products.astro'
import { ArrowUpRight } from 'lucide-preact'

interface Props {
  lang: 'es' | 'en'
}

const { lang = 'es' } = Astro.props
const t = lang === 'es' ? es : en
const announcements = t['header.announcements']
---

<Layout slogan={t['header.slogan']}>
  <div>
    <AnnouncementsBar
      announcements={Array.isArray(announcements) ? announcements : [announcements]}
    />

    <div class='mb-8'>
      <a
        class='group inline-flex items-center gap-1.5 font-medium hover:underline'
        href={getRelativeLocaleUrl(lang, 'catalog')}
      >
        {t['nav.catalog']}
        <span class='transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5'>
          <ArrowUpRight size={18} strokeWidth={2.5} aria-hidden='true' />
        </span>
      </a>
    </div>

    <Products lang={lang} />
  </div>
</Layout>
