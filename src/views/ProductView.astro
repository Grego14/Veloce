---
import { Image } from 'astro:assets'
import { getRelativeLocaleUrl } from 'astro:i18n'

import AddToCart from '@components/AddToCart'
import Star from '@icons/Star'
import Layout from '@layouts/Layout.astro'
import { es } from '@i18n/locales/es'
import { en } from '@i18n/locales/en'

interface Props {
  lang: 'es' | 'en'
  category: string
  product: import('astro:content').CollectionEntry<'products'>['data'][number]
}

const { lang, category, product } = Astro.props
const t = lang === 'es' ? es : en
const colorCount = product.colors?.length ?? 0
const colorLabel = colorCount === 1 ? t['product.color'] : t['product.colors']
const tags = product.tags?.slice(0, 3)
const ratingStars = Math.round(product.rating)
---

<Layout slogan={product.name[lang]}>
  <a
    class='mb-8 inline-flex items-center border-2 border-zinc-950 px-3 py-2 text-sm font-semibold uppercase tracking-wide transition-colors hover:bg-zinc-950 hover:text-white'
    href={getRelativeLocaleUrl(lang, `catalog/${category}`)}
  >
    ← {t['nav.catalog']}
  </a>

  <article class='grid gap-8 lg:grid-cols-2 lg:items-start'>
    <div class='relative aspect-square overflow-hidden bg-zinc-100'>
      <Image
        src={product.image}
        alt={product.description[lang]}
        class='h-full w-full object-contain'
        fit='contain'
        position='center'
      />
      {!product.inStock ? (
        <span
          class='absolute right-4 top-4 bg-rose-600 px-3 py-2 text-xs font-semibold uppercase tracking-wide text-white'
          role='alert'
        >
          {t['product.outOfStock']}
        </span>
      ) : null}
    </div>

    <div class='border-2 border-zinc-950 bg-zinc-950 p-6 text-white sm:p-8'>
      <p class='text-sm font-semibold uppercase tracking-[0.18em] text-zinc-400'>
        {product.category}
      </p>
      <h2 class='mt-3 text-3xl'>{product.name[lang]}</h2>
      <p class='mt-6 text-lg font-light leading-relaxed text-zinc-300'>
        {product.description[lang]}
      </p>

      <div class='mt-8 flex items-center justify-between border-y border-zinc-700 py-4'>
        <span class='text-3xl font-semibold tracking-tight'>${product.price.toFixed(2)}</span>
        <span
          class='flex items-center gap-1 text-amber-400'
          aria-label={`${t['product.rating']}: ${product.rating.toFixed(1)}`}
        >
          {
            Array.from({ length: 5 }, (_, index) => (
              <Star
                className={`h-5 w-5 ${index < ratingStars ? 'fill-current' : 'text-zinc-600'}`}
              />
            ))
          }
        </span>
      </div>

      <div class='mt-5 flex items-center justify-between text-sm text-zinc-300'>
        <span>{colorCount} {colorLabel}</span>
        <span>{product.inStock ? t['product.inStock'] : t['product.outOfStock']}</span>
      </div>

      {Array.isArray(tags) ? (
        <div class='mt-5 flex flex-wrap gap-1.5'>
          {tags.map(tag => (
            <span class='border border-zinc-700 px-2 py-1 text-xs uppercase tracking-wider text-zinc-400'>
              #{tag}
            </span>
          ))}
        </div>
      ) : null}

      <AddToCart client:idle lang={lang} product={product} />
    </div>
  </article>
</Layout>
