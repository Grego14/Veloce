---
import { getCollection } from 'astro:content'
import { getRelativeLocaleUrl } from 'astro:i18n'

import Layout from '@layouts/Layout.astro'
import Products from '@components/Products.astro'
import { es } from '@i18n/locales/es'
import { en } from '@i18n/locales/en'

interface Props {
  lang: 'es' | 'en'
  category: (typeof import('@i18n/utils').categories)[number]
}

const { lang, category } = Astro.props
const t = lang === 'es' ? es : en
const products = (await getCollection('products')).find(entry => entry.id === category)?.data ?? []
const categoryName = t[`category.${category}`]
const categorySlogan = t['category.slogans'][category]
---

<Layout slogan={categorySlogan}>
  <main>
    <a
      class='mb-8 inline-flex font-medium hover:underline'
      href={getRelativeLocaleUrl(lang, 'catalog')}
    >
      ← {t['nav.catalog']}
    </a>

    <div class='mb-10 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between'>
      <div>
        <p class='text-sm font-semibold uppercase tracking-[0.18em]'>{categorySlogan}</p>
        <h2 class='mt-2'>{categoryName}</h2>
      </div>
      <p class='text-lg font-light'>
        {products.length} {t['nav.itemsAvailable']}
      </p>
    </div>

    <Products lang={lang} products={products} />
  </main>
</Layout>
