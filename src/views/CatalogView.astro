---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import { getRelativeLocaleUrl } from 'astro:i18n'

import Layout from '@layouts/Layout.astro'
import { es } from '@i18n/locales/es'
import { en } from '@i18n/locales/en'
import { categories } from '@i18n/utils'

interface Props {
  lang: 'es' | 'en'
}

const { lang } = Astro.props
const t = lang === 'es' ? es : en
const products = await getCollection('products')
const categorySlogans = t['category.slogans']
---

<Layout slogan={t['nav.catalog']}>
  <main>
    <div class='mb-10 max-w-2xl'>
      <p class='text-xl leading-relaxed'>{t['nav.catalogDescription']}</p>
    </div>

    <section aria-labelledby='catalog-categories-title'>
      <h2 id='catalog-categories-title' class='sr-only'>{t['nav.categories']}</h2>
      <div class='grid gap-6 sm:grid-cols-2 lg:grid-cols-3'>
        {
          categories.map(category => {
            const categoryProducts = products.find(entry => entry.id === category)?.data ?? []
            const featuredProduct = categoryProducts[0]

            return (
              <a
                class='group flex flex-col border-2 border-zinc-950 bg-white transition-transform hover:-translate-y-1'
                href={getRelativeLocaleUrl(lang, `catalog/${category}`)}
              >
                <div class='aspect-[4/3] overflow-hidden bg-zinc-100'>
                  {featuredProduct ? (
                    <Image
                      src={featuredProduct.image}
                      alt={t[`category.${category}`]}
                      class='h-full w-full object-contain transition-transform duration-300 group-hover:scale-105'
                      fit='contain'
                      position='center'
                      loading='lazy'
                      decoding='async'
                    />
                  ) : null}
                </div>
                <div class='flex flex-1 flex-col p-5'>
                  <div class='flex items-start justify-between gap-4'>
                    <h3 class='text-2xl font-semibold group-hover:underline'>
                      {t[`category.${category}`]}
                    </h3>
                    <span class='shrink-0 text-sm font-semibold uppercase tracking-wider'>
                      {categoryProducts.length}{' '}
                      {categoryProducts.length === 1 ? t['nav.item'] : t['nav.items']}
                    </span>
                  </div>
                  <p class='mt-3 text-lg font-light leading-tight'>{categorySlogans[category]}</p>
                  <span class='mt-6 font-semibold uppercase tracking-wider'>
                    {t['nav.viewCategory']} →
                  </span>
                </div>
              </a>
            )
          })
        }
      </div>
    </section>
  </main>
</Layout>
